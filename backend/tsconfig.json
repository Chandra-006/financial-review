{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Node16",
    "moduleResolution": "Node16",
    "checkJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": false,
    "esModuleInterop": true,
    "allowJs": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "**/node_modules/**"]
}
